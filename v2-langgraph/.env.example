# From @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the staff account/group (staff must /start the bot first)
STAFF_CHAT_ID=
# Gemini API key (chat + embeddings)
GOOGLE_API_KEY=
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic

CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
# must match vector(768) in schema.sql
EMBEDDING_DIMS=768
CLINIC_TIMEZONE=Africa/Cairo

# max text messages per chat per hour (use 20 for demos)
RATE_LIMIT_PER_HOUR=20
# messages kept in the model context
MEMORY_WINDOW=20
# calibrate with evals/run_eval.py
RETRIEVAL_MIN_SIMILARITY=0.5

# USD per 1M tokens - set to your model's real pricing; used for the cost column in the turns log
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.40

# Optional: LangSmith tracing of every graph run
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
