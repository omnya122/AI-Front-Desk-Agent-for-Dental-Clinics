# Telegram TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Supabase (vector store) SUPABASE_URL=your_supabase_project_url
  SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
# Google Gemini (embeddings + chat model) GOOGLE_GEMINI_API_KEY=your_gemini_api_key
# Google (Drive, Sheets, Calendar — configured via OAuth in n8n, not a raw key) GOOGLE_OAUTH_CREDENTIALS=configured_via_n8n_google_credential